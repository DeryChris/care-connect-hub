# ─── File Storage ─────────────────────────────────────────────────────────────
# Options: 'local' | 's3'
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# ─── AWS S3 (only needed when STORAGE_DRIVER=s3) ──────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=care-connect-hub-docs

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
