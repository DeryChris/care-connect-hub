SMTP_PORT=587
SMTP_USER=noreply@yourhospital.com
SMTP_PASS=your_app_password
EMAIL_FROM="Care Connect Hub <noreply@yourhospital.com>"

# ─── Redis (optional — for session caching) ──────────────────────────────────
REDIS_URL=redis://localhost:6379
